# Copia este archivo a .env.local y rellénalo. .env.local nunca se sube a git.

# --- El modelo. Sirve la de OpenAI o la de Anthropic, la que tengas.
# Si están las dos gana Anthropic, o fuerzas una con PROVEEDOR=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# PROVEEDOR=openai
# MODELO_ANTHROPIC=
# MODELO_OPENAI=
# Corre `npm run modelos` para ver qué modelos acepta tu clave.

# --- La base de datos. Postgres a secas: sirve Supabase, Neon o el tuyo.
# En Supabase: Project Settings → Database → Connection string → Transaction pooler.
DATABASE_URL=

# --- Cuentas. Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
