# Copia este archivo a .env.local y rellena los huecos.
# .env.local no se sube a git nunca.
#
# Cuando termines, comprueba que está todo bien con:
#   npm run comprobar
# Te dice qué falta y qué tiene mala forma, sin imprimir ninguna clave.


# ─────────────────────────────────────────────────────────────
# 1 · EL MODELO
# ─────────────────────────────────────────────────────────────
# Sirve la de OpenAI o la de Anthropic — con una basta.
# Si pones las dos gana Anthropic, o fuerzas con PROVEEDOR.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# PROVEEDOR=openai
# MODELO_ANTHROPIC=
# MODELO_OPENAI=
# Corre `npm run modelos` para ver qué modelos acepta tu clave.


# ─────────────────────────────────────────────────────────────
# 2 · LA BASE DE DATOS
# ─────────────────────────────────────────────────────────────
# OJO: no es la dirección https://xxxx.supabase.co — esa es la de la API y no
# sirve aquí. Lo que hace falta es la cadena de Postgres, que empieza por
# postgresql:// y lleva dentro la contraseña de la base.
#
# En Supabase:
#   botón «Connect», arriba del todo del proyecto
#   → pestaña «Connection string»
#   → elige «Transaction pooler»
#   → copia la línea entera y cambia [YOUR-PASSWORD] por la contraseña
#
# ¿No te acuerdas de esa contraseña? No es la de tu cuenta de Supabase: es la
# de la base, y se pone al crear el proyecto. Se cambia en
# Project Settings → Database → Reset database password.
#
# Queda algo con esta forma:
# postgresql://postgres.abcdefghijk:LA-CONTRASEÑA@aws-1-us-east-1.pooler.supabase.com:6543/postgres
#
# La contraseña va tal cual, aunque lleve símbolos raros. No hace falta
# codificar nada: el sistema lo hace por ti.

DATABASE_URL=


# ─────────────────────────────────────────────────────────────
# 3 · LAS CUENTAS DE CADENCIA
# ─────────────────────────────────────────────────────────────
# Este secreto NO sale de Supabase ni de ningún proveedor. Es un texto al azar
# que genera tu propia máquina y solo sirve para firmar las sesiones.
# Genéralo con:  npm run secreto
# Y pega aquí la línea que te imprima.

BETTER_AUTH_SECRET=

# En local se queda así. En producción, la dirección real del sitio — y es
# además el ORIGEN PERMITIDO: Better Auth rechaza las peticiones que no vengan
# de aquí, que es lo que impide que otra web use la sesión del dueño.
#
# Sin barra final. Un origen es esquema + host + puerto, sin ruta, y
# «https://…/» con barra no casa con lo que manda el navegador.
#
#   producción:  BETTER_AUTH_URL=https://cadencia-jade.vercel.app
BETTER_AUTH_URL=http://localhost:3000


# ── El panel de administración ───────────────────────────────────────────────
# La dirección secreta del panel: queda en /panel/<PANEL_LLAVE>.
#
# Genérala con: npm run llave
#
# Va aquí y no escrita en el código porque una ruta fija en el repositorio la
# sabe cualquiera que lea el repositorio. Sin esta variable el panel NO EXISTE:
# cualquier dirección devuelve 404, que es el valor por defecto correcto.
#
# Y por sí sola no autoriza nada. No hay entrada aparte para administrar: se
# entra por la misma pantalla que todo el mundo, con el mismo correo y la misma
# contraseña. Lo que abre el panel es lo que diga `role` en la base.
#
# Así se da de alta el primer administrador:
#
#   1. Crea tu cuenta normal en /entrar, como cualquiera.
#   2. Márcala en la base. Desde aquí:
#
#        npm run rol -- tu@correo.com admin
#
#      o directamente en el SQL del proveedor, que es lo mismo:
#
#        update "user" set role = 'admin' where lower(email) = 'tu@correo.com';
#
#   3. Entra en /panel/<PANEL_LLAVE>.
#
# Para quitarlo:  update "user" set role = null where lower(email) = '…';
# La cuenta sigue intacta para todo lo demás: el rol no es un tipo de cuenta,
# es un permiso encima de una cuenta normal.
PANEL_LLAVE=


# ─────────────────────────────────────────────────────────────
# 4 · CORREO  (opcional en local)
# ─────────────────────────────────────────────────────────────
# Solo hace falta para que el enlace de "olvidé mi contraseña" llegue de verdad.
# Sin esto, el enlace se imprime en la terminal donde corre `npm run dev`, que
# para trabajar en tu máquina es suficiente.
#
# Si ya no puedes entrar y no tienes correo montado, hay una llave maestra:
#   npm run clave                      → lista las cuentas de tu base
#   npm run clave -- tu@correo.com     → le pone una contraseña nueva

# RESEND_API_KEY=
# CORREO_DESDE=Cadencia <hola@tudominio.com>


# ─────────────────────────────────────────────────────────────
# 5 · FOTOS DE ARCHIVO  (opcional)
# ─────────────────────────────────────────────────────────────
# Para que el carrusel pueda buscar fotos sin que tengas que hacerlas tú.
# Pexels es gratis y sin coste por imagen: se saca en pexels.com/api,
# tarda un minuto y no pide tarjeta.
#
# Sin esto, las láminas siguen funcionando: pones tus propias fotos, o van
# solo con texto.

# PEXELS_API_KEY=
